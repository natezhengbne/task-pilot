{
  "name": "TaskPilot - Vulnerability Remediation (Phase 1 / 2 / 3)",
  "nodes": [
    {
      "parameters": {
        "formTitle": "TaskPilot Vulnerability Remediation",
        "formDescription": "Upload a vulnerability export (e.g. Wiz GraphQL JSON). Choose Phase 1 (Analysis only), Phase 2 (Copilot remediation + verification), or Phase 3 (Full remediation + Draft PR).",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Report File",
              "fieldType": "file",
              "multipleFiles": false,
              "acceptFileTypes": ".json",
              "requiredField": true
            },
            {
              "fieldLabel": "Source",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "wiz-graphql" }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Min Severity",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "HIGH" },
                  { "option": "CRITICAL" },
                  { "option": "MEDIUM" },
                  { "option": "LOW" }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Owned Scopes",
              "fieldType": "text",
              "placeholder": "@your-org/ (optional; defaults to config/ownership.json)",
              "requiredField": false
            },
            {
              "fieldLabel": "Phase",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "Phase 1 - Analysis Only" },
                  { "option": "Phase 2 - Copilot Remediation (Verify Only)" },
                  { "option": "Phase 3 - Full Remediation + Draft PR" }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Max Retries",
              "fieldType": "number",
              "placeholder": "3",
              "requiredField": false
            },
            {
              "fieldLabel": "Credit Budget",
              "fieldType": "number",
              "placeholder": "30",
              "requiredField": false
            },
            {
              "fieldLabel": "Verify Downstream",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  { "option": "No" },
                  { "option": "Yes" }
                ]
              },
              "requiredField": false
            }
          ]
        },
        "options": {}
      },
      "id": "form-trigger-1",
      "name": "1. Upload Vulnerability Report",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [160, 200],
      "webhookId": "vulnerability-remediation-upload"
    },
    {
      "parameters": {
        "operation": "fromJson",
        "binaryPropertyName": "Report_File",
        "destinationKey": "reportPayload",
        "options": {}
      },
      "id": "extract-json-1",
      "name": "2. Extract JSON from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [420, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TASKPILOT_API_URL || 'http://127.0.0.1:3456') + '/api/vulnerabilities/ingest' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: $('1. Upload Vulnerability Report').item.json.Source || 'wiz-graphql', runId: 'n8n-' + $execution.id, policy: { minSeverity: $('1. Upload Vulnerability Report').item.json['Min Severity'] || 'HIGH', ...($('1. Upload Vulnerability Report').item.json['Owned Scopes'] ? { ownedScopes: $('1. Upload Vulnerability Report').item.json['Owned Scopes'].split(',').map(s => s.trim()).filter(Boolean) } : {}) }, payload: $json.reportPayload }) }}",
        "options": {}
      },
      "id": "http-ingest-1",
      "name": "📥 3. Ingest Vulnerabilities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TASKPILOT_API_URL || 'http://127.0.0.1:3456') + '/api/vulnerabilities/plan' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ runId: $json.runId, useGitHub: true, ownedScopes: $json.policy.ownedScopes, findings: $json.findings }) }}",
        "options": {}
      },
      "id": "http-plan-1",
      "name": "🔍 4. Plan Remediation Targets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 200]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-phase",
              "leftValue": "={{ $('1. Upload Vulnerability Report').item.json.Phase || 'Phase 1 - Analysis Only' }}",
              "rightValue": "Phase 1 - Analysis Only",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            },
            {
              "id": "cond-plans",
              "leftValue": "={{ ($json.plans || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-execute-remediation",
      "name": "5. Execute Remediation?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Phase 1 Analysis Complete",
        "completionMessage": "={{ 'Run ID: ' + $json.runId + '\\nTotal Findings: ' + ($json.summary?.inputFindings ?? 0) + '\\nTarget Repos: ' + ($json.summary?.planCount ?? 0) + '\\n\\n' + ($json.plans || []).map(p => `- ${p.targetRepo} (${p.ownership}, ${p.packageCount} pkgs, ${p.cveCount} CVEs, max ${p.maxSeverity})`).join('\\n') }}",
        "options": {}
      },
      "id": "form-end-phase1",
      "name": "5b. Show Analysis Summary",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [1480, 200]
    },
    {
      "parameters": {
        "jsCode": "const form = $('1. Upload Vulnerability Report').first().json;\nconst planResp = $input.first().json;\nconst plans = planResp.plans || [];\nconst maxRetries = Number(form['Max Retries']) > 0 ? Number(form['Max Retries']) : 3;\nconst creditBudget = Number(form['Credit Budget']) > 0 ? Number(form['Credit Budget']) : 30;\nconst verifyDownstream = form['Verify Downstream'] === 'Yes';\nconst phase = form.Phase || 'Phase 2 - Copilot Remediation (Verify Only)';\n\nreturn plans.map((plan) => ({\n  json: {\n    runId: planResp.runId,\n    phase,\n    maxRetries,\n    creditBudget,\n    verifyDownstream,\n    plan,\n  },\n}));"
      },
      "id": "code-expand-plans",
      "name": "6. Expand Plans per Repo",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [160, 560]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "loop-repos-1",
      "name": "7. Loop Over Repos",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [420, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TASKPILOT_API_URL || 'http://127.0.0.1:3456') + '/api/remediation/workspace/prepare' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ runId: $json.runId, plan: $json.plan }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-prepare-ws",
      "name": "📦 8. Prepare Workspace & Branch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 560]
    },
    {
      "parameters": {
        "jsCode": "const loopItem = $('7. Loop Over Repos').first().json;\nconst ws = $input.first().json;\n\nreturn [{\n  json: {\n    runId: ws.runId,\n    phase: loopItem.phase,\n    maxRetries: loopItem.maxRetries,\n    creditBudget: loopItem.creditBudget,\n    verifyDownstream: loopItem.verifyDownstream,\n    plan: ws.plan,\n    targetRepo: ws.targetRepo,\n    baseBranch: ws.baseBranch,\n    remediationBranch: ws.remediationBranch,\n    workspacePath: ws.workspacePath,\n    attempt: 1,\n    creditsUsed: 0,\n    previousError: null,\n  },\n}];"
      },
      "id": "code-init-retry",
      "name": "9. Init Attempt State",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [940, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TASKPILOT_API_URL || 'http://127.0.0.1:3456') + '/api/remediation/patch' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ runId: $json.runId, workspacePath: $json.workspacePath, plan: $json.plan, attempt: $json.attempt, maxRetries: $json.maxRetries, creditBudget: $json.creditBudget, creditsUsed: $json.creditsUsed, previousError: $json.previousError }) }}",
        "options": {
          "timeout": 320000
        }
      },
      "id": "http-copilot-patch",
      "name": "🤖 10. Copilot Patch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1200, 560]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TASKPILOT_API_URL || 'http://127.0.0.1:3456') + '/api/remediation/verify' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ runId: $json.runId, workspacePath: $json.workspacePath, plan: $('9. Init Attempt State').first().json.plan, verifyDownstream: $('9. Init Attempt State').first().json.verifyDownstream }) }}",
        "options": {
          "timeout": 240000
        }
      },
      "id": "http-verify-patch",
      "name": "🧪 11. Verify Patch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 560]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-verified",
              "leftValue": "={{ Boolean($json.passed) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-verify-passed",
      "name": "12. Verification Passed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1720, 560]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-retry-count",
              "leftValue": "={{ $('🤖 10. Copilot Patch').first().json.attempt }}",
              "rightValue": "={{ $('🤖 10. Copilot Patch').first().json.maxRetries }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            },
            {
              "id": "cond-credit-budget",
              "leftValue": "={{ $('🤖 10. Copilot Patch').first().json.creditsUsed }}",
              "rightValue": "={{ $('🤖 10. Copilot Patch').first().json.creditBudget }}",
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-can-retry",
      "name": "12b. Retry Budget Remaining?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1980, 750]
    },
    {
      "parameters": {
        "jsCode": "const state = $('9. Init Attempt State').first().json;\nconst patch = $('🤖 10. Copilot Patch').first().json;\nconst verify = $input.first().json;\n\nreturn [{\n  json: {\n    ...state,\n    attempt: (patch.attempt || 1) + 1,\n    creditsUsed: patch.creditsUsed || 0,\n    previousError: verify.failureSummary || patch.error || 'Verification failed.',\n  },\n}];"
      },
      "id": "code-next-retry",
      "name": "12c. Prepare Next Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1460, 750]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.TASKPILOT_API_URL || 'http://127.0.0.1:3456') + '/api/remediation/pr' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ runId: $json.runId, workspacePath: $json.workspacePath, plan: $('9. Init Attempt State').first().json.plan, remediationBranch: $('9. Init Attempt State').first().json.remediationBranch, baseBranch: $('9. Init Attempt State').first().json.baseBranch, verification: $json, copilotSummary: $('🤖 10. Copilot Patch').first().json.copilotOutput, draft: true, dryRun: $('9. Init Attempt State').first().json.phase !== 'Phase 3 - Full Remediation + Draft PR' }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "http-create-pr",
      "name": "🔀 13. Create Draft PR / Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1720, 1130]
    },
    {
      "parameters": {
        "jsCode": "const state = $('9. Init Attempt State').first().json;\nconst patch = $('🤖 10. Copilot Patch').first().json;\nconst verify = $input.first().json;\n\nreturn [{\n  json: {\n    ok: false,\n    status: 'failed',\n    targetRepo: state.targetRepo,\n    remediationBranch: state.remediationBranch,\n    attempts: patch.attempt,\n    creditsUsed: patch.creditsUsed,\n    creditBudget: patch.creditBudget,\n    reason: 'Verification failed; retry or credit limit reached',\n    failureSummary: verify.failureSummary || patch.error || null,\n  },\n}];"
      },
      "id": "code-record-failure",
      "name": "14. Record Failed Remediation",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 1130]
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Remediation Workflow Complete",
        "completionMessage": "={{ 'Processed ' + $input.all().length + ' repository remediation(s):\\n\\n' + $input.all().map(i => { const d = i.json; if (d.prUrl) return `- [DRAFT PR] ${d.targetRepo}: ${d.prUrl}`; if (d.dryRun) return `- [VERIFIED / DRY RUN] ${d.targetRepo} (${d.remediationBranch})`; return `- [FAILED] ${d.targetRepo}: ${d.reason || d.error || 'see execution logs'}`; }).join('\\n') }}",
        "options": {}
      },
      "id": "form-end-remediation",
      "name": "15. Show Remediation Summary",
      "type": "n8n-nodes-base.form",
      "typeVersion": 1,
      "position": [420, 1130]
    }
  ],
  "connections": {
    "1. Upload Vulnerability Report": {
      "main": [
        [{ "node": "2. Extract JSON from File", "type": "main", "index": 0 }]
      ]
    },
    "2. Extract JSON from File": {
      "main": [
        [{ "node": "📥 3. Ingest Vulnerabilities", "type": "main", "index": 0 }]
      ]
    },
    "📥 3. Ingest Vulnerabilities": {
      "main": [
        [{ "node": "🔍 4. Plan Remediation Targets", "type": "main", "index": 0 }]
      ]
    },
    "🔍 4. Plan Remediation Targets": {
      "main": [
        [{ "node": "5. Execute Remediation?", "type": "main", "index": 0 }]
      ]
    },
    "5. Execute Remediation?": {
      "main": [
        [{ "node": "6. Expand Plans per Repo", "type": "main", "index": 0 }],
        [{ "node": "5b. Show Analysis Summary", "type": "main", "index": 0 }]
      ]
    },
    "6. Expand Plans per Repo": {
      "main": [
        [{ "node": "7. Loop Over Repos", "type": "main", "index": 0 }]
      ]
    },
    "7. Loop Over Repos": {
      "main": [
        [{ "node": "15. Show Remediation Summary", "type": "main", "index": 0 }],
        [{ "node": "📦 8. Prepare Workspace & Branch", "type": "main", "index": 0 }]
      ]
    },
    "📦 8. Prepare Workspace & Branch": {
      "main": [
        [{ "node": "9. Init Attempt State", "type": "main", "index": 0 }]
      ]
    },
    "9. Init Attempt State": {
      "main": [
        [{ "node": "🤖 10. Copilot Patch", "type": "main", "index": 0 }]
      ]
    },
    "🤖 10. Copilot Patch": {
      "main": [
        [{ "node": "🧪 11. Verify Patch", "type": "main", "index": 0 }]
      ]
    },
    "🧪 11. Verify Patch": {
      "main": [
        [{ "node": "12. Verification Passed?", "type": "main", "index": 0 }]
      ]
    },
    "12. Verification Passed?": {
      "main": [
        [{ "node": "🔀 13. Create Draft PR / Report", "type": "main", "index": 0 }],
        [{ "node": "12b. Retry Budget Remaining?", "type": "main", "index": 0 }]
      ]
    },
    "12b. Retry Budget Remaining?": {
      "main": [
        [{ "node": "12c. Prepare Next Retry", "type": "main", "index": 0 }],
        [{ "node": "14. Record Failed Remediation", "type": "main", "index": 0 }]
      ]
    },
    "12c. Prepare Next Retry": {
      "main": [
        [{ "node": "🤖 10. Copilot Patch", "type": "main", "index": 0 }]
      ]
    },
    "🔀 13. Create Draft PR / Report": {
      "main": [
        [{ "node": "7. Loop Over Repos", "type": "main", "index": 0 }]
      ]
    },
    "14. Record Failed Remediation": {
      "main": [
        [{ "node": "7. Loop Over Repos", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  }
}
